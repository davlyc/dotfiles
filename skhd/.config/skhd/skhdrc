# ─────────── FOCUS (Hyprland style) ───────────
alt - left  : yabai -m window --focus west
alt - right : yabai -m window --focus east
alt - down  : yabai -m window --focus south
alt - up    : yabai -m window --focus north

# ─────────── SWAP ───────────
shift + alt - left  : yabai -m window --swap west
shift + alt - right : yabai -m window --swap east
shift + alt - down  : yabai -m window --swap south
shift + alt - up    : yabai -m window --swap north

# ─────────── MOVE WINDOW BETWEEN SPACES ───────────
shift + alt - h : yabai -m window --space prev
shift + alt - l : yabai -m window --space next

# ─────────── FOCUS SPACES ───────────
ctrl + alt - left  : yabai -m space --focus prev
ctrl + alt - right : yabai -m space --focus next

# ─────────── LAYOUT CONTROL ───────────
alt - f : yabai -m window --toggle float
alt - m : yabai -m window --toggle zoom-fullscreen

# ─────────── BALANCE ───────────
alt - b : yabai -m space --balance

# ─────────── SAFE CLOSE ───────────
shift + alt - q : yabai -m window --close && sleep 0.1 && yabai -m space --balance

# ─────────── WINDOW RESIZE ───────────
ctrl + shift - left  : yabai -m window --resize left:-20:0
ctrl + shift - right : yabai -m window --resize right:20:0
ctrl + shift - down  : yabai -m window --resize bottom:20:0
ctrl + shift - up    : yabai -m window --resize top:-20:0

# ─────────── ROTATE LAYOUT ───────────
alt - r : yabai -m space --rotate 90

# Press Alt + Shift + B to launch the orange monitor
alt + shift - b : kitty --title "System Monitor" btm

# Open a new Kitty window directly into Neovim
alt - v : kitty nvim
